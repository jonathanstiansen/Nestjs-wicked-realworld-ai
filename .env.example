# Application
NODE_ENV=development
PORT=3000

# Database Configuration (MySQL for production)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password
DB_NAME=nestjs_realworld

# Database Configuration (SQLite for testing)
# When NODE_ENV=test, the app will use SQLite in-memory database
# No additional configuration needed for SQLite testing mode

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-use-strong-random-string
